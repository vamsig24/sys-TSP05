{
  "configById": {
    "Indicator!mode": {
      "path": "/tsp05/mode.data",
      "style": "background",
      "fontSize": 22,
      "fallbackColor": "#757575",
      "fallbackLabel": "no data",
      "rules": [
        {
          "operator": "=",
          "rawValue": "GUI",
          "color": "#1e88e5",
          "label": "GUI MODE"
        },
        {
          "operator": "=",
          "rawValue": "SENSOR",
          "color": "#43a047",
          "label": "SENSOR MODE"
        }
      ],
      "foxglovePanelTitle": "Mode"
    },
    "Indicator!safety": {
      "path": "/tsp05/safety/active.data",
      "style": "background",
      "fontSize": 16,
      "fallbackColor": "#43a047",
      "fallbackLabel": "Clear",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#e53935",
          "label": "SAFETY STOP (obstacle at Sharp)"
        }
      ],
      "foxglovePanelTitle": "Safety"
    },
    "Indicator!connected": {
      "path": "/tsp05/connected.data",
      "style": "bulb",
      "fontSize": 14,
      "fallbackColor": "#e53935",
      "fallbackLabel": "Arduino not connected",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#43a047",
          "label": "Arduino connected"
        }
      ],
      "foxglovePanelTitle": "Arduino"
    },
    "Publish!mode_gui": {
      "topicName": "/tsp05/cmd/mode",
      "datatype": "std_msgs/msg/String",
      "buttonText": "GUI mode",
      "advancedView": false,
      "value": "{\n  \"data\": \"GUI\"\n}",
      "buttonColor": "#1e88e5",
      "foxglovePanelTitle": "Switch mode"
    },
    "Publish!mode_sensor": {
      "topicName": "/tsp05/cmd/mode",
      "datatype": "std_msgs/msg/String",
      "buttonText": "SENSOR mode",
      "advancedView": false,
      "value": "{\n  \"data\": \"SENSOR\"\n}",
      "buttonColor": "#43a047",
      "foxglovePanelTitle": "Switch mode"
    },
    "Publish!servo": {
      "topicName": "/tsp05/cmd/servo_angle",
