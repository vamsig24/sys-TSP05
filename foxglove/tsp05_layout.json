    "RawMessages!events": {
      "topicPath": "/tsp05/events",
      "fontSize": 12,
      "expansion": "all",
      "foxglovePanelTitle": "Arduino replies / events"
    },
    "Tab!left": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Motor controls (GUI mode)",
          "layout": {
            "direction": "column",
            "first": {
              "direction": "row",
              "first": "Publish!mode_gui",
              "second": "Publish!mode_sensor",
              "splitPercentage": 50.0
            },
            "second": {
              "direction": "column",
              "first": "Publish!servo",
              "second": {
                "direction": "column",
                "first": {
                  "direction": "row",
                  "first": "Publish!servo_0",
                  "second": {
                    "direction": "row",
                    "first": "Publish!servo_90",
                    "second": "Publish!servo_180",
                    "splitPercentage": 50.0
                  },
                  "splitPercentage": 33.333333333333336
                },
                "second": {
                  "direction": "column",
                  "first": {
                    "direction": "row",
                    "first": "Publish!step_minus",
                    "second": "Publish!step_plus",
                    "splitPercentage": 50.0
                  },
                  "second": {
                    "direction": "column",
                    "first": "Publish!step",
                    "second": {
                      "direction": "column",
                      "first": "Publish!dc",
                      "second": "Publish!dc_stop",
                      "splitPercentage": 50.0
                    },
                    "splitPercentage": 33.333333333333336
                  },
                  "splitPercentage": 25.0
                },
                "splitPercentage": 20.0
              },
              "splitPercentage": 16.666666666666668
            },
            "splitPercentage": 14.285714285714286
          }
        },
        {
          "title": "Calibrate force sensor",
          "layout": {
            "direction": "column",
            "first": "Markdown!cal_help",
            "second": {
              "direction": "column",
              "first": {
