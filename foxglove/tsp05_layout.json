      "buttonText": "Set servo angle",
      "advancedView": true,
      "value": "{\n  \"data\": 90.0\n}",
      "foxglovePanelTitle": "Servo angle (0-180 deg)"
    },
    "Publish!servo_0": {
      "topicName": "/tsp05/cmd/servo_angle",
      "datatype": "std_msgs/msg/Float32",
      "buttonText": "Servo 0 deg",
