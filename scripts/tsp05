#!/usr/bin/env bash
# One command for building, flashing and testing TSP05 from the host.
#
#   scripts/tsp05 check          guided hardware test (PASS/FAIL summary)
#   scripts/tsp05 check --auto   automatic checks only, no prompts
#   scripts/tsp05 watch          live one-line view of sensors and motors
#   scripts/tsp05 mode gui|sensor|toggle
#   scripts/tsp05 servo 90 | step 15 | dc 40 | safety 20
#   scripts/tsp05 calibrate      guided flex (force sensor) calibration
#   scripts/tsp05 foxglove       start bridge + open Foxglove (then import the layout)
#
#   scripts/tsp05 flash          compile + upload the Arduino sketch
#   scripts/tsp05 start          start bridge + foxglove_bridge (ws://localhost:8765)
#   scripts/tsp05 stop           stop them
#   scripts/tsp05 restart        stop + start (e.g. after editing the node)
#   scripts/tsp05 logs           follow the bridge log
#   scripts/tsp05 build          colcon build the ROS 2 workspace
#   scripts/tsp05 unit           protocol unit tests (no hardware)
#   scripts/tsp05 shell          shell in the container
#
# Everything except flash runs inside the f1tenth container, which is
# created/started automatically (docker/f1_new_terminal.sh).

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONTAINER=f1tenth
PORT="${TSP05_PORT:-/dev/ttyACM0}"
FQBN=arduino:avr:uno
BRIDGE_LOG=/tmp/tsp05_bridge.log
ROS_ENV='source /opt/ros/humble/setup.bash; [ -f /tsp05/ros2_ws/install/setup.bash ] && source /tsp05/ros2_ws/install/setup.bash'

info() { printf '\033[36m[tsp05]\033[0m %s\n' "$*"; }
die()  { printf '\033[31m[tsp05]\033[0m %s\n' "$*" >&2; exit 1; }

# ----------------------------------------------------------------------
# Container helpers
# ----------------------------------------------------------------------

ensure_container() {
    "$REPO/docker/f1_new_terminal.sh" true </dev/null
}

# Run as root (needed for the serial port)
in_container() {
    docker exec -i "$CONTAINER" bash -c "$ROS_ENV; $1"
}

# Run as the host user so build files in the repo stay owned by you
in_container_as_user() {
    docker exec -i -u "$(id -u):$(id -g)" -e HOME=/tmp "$CONTAINER" \
        bash -c "$ROS_ENV; $1"
}

build() {
    info "Building ROS 2 workspace"
    in_container_as_user 'cd /tsp05/ros2_ws && colcon build --symlink-install 2>&1 | tail -2'
}

ensure_built() {
    # Console scripts are generated (not symlinked) by colcon, so they show
    # whether the build is older than setup.py (entry points / data files).
    local stamp="$REPO/ros2_ws/install/tsp05_bridge/lib/tsp05_bridge/tsp05"
    if [ ! -e "$stamp" ] || [ "$REPO/ros2_ws/src/tsp05_bridge/setup.py" -nt "$stamp" ]; then
        build
    fi
}

# The launch process exists from the moment the bridge is started
bridge_running() {
    docker exec "$CONTAINER" pgrep -f 'ros2 launch tsp05_bridge|lib/tsp05_bridge/tsp05_serial_node' >/dev/null 2>&1
}

check_port_free() {
    [ -e "$PORT" ] || die "$PORT not found - is the Arduino plugged in?"
    local users
    users="$(fuser "$PORT" 2>/dev/null || true)"
    if [ -n "$users" ]; then
        local names
        names="$(ps -o comm= -p $users 2>/dev/null | sort -u | tr '\n' ' ')"
        die "$PORT is in use by: $names- close the Arduino IDE Serial Monitor"
    fi
}

start_bridge() {
    if bridge_running; then
        return
    fi
    check_port_free
    info "Starting bridge + foxglove_bridge (log: $BRIDGE_LOG in container)"
    # Remove the old log so the wait below cannot match a previous run
    docker exec "$CONTAINER" rm -f "$BRIDGE_LOG"
    docker exec -d "$CONTAINER" bash -c \
        "$ROS_ENV; exec ros2 launch tsp05_bridge tsp05.launch.py port:=$PORT > $BRIDGE_LOG 2>&1"
    for _ in $(seq 1 40); do
        if docker exec "$CONTAINER" grep -q 'Receiving data from Arduino' "$BRIDGE_LOG" 2>/dev/null; then
            info "Bridge connected. Foxglove: ws://localhost:8765"
            return
        fi
        sleep 0.25
    done
    docker exec "$CONTAINER" tail -5 "$BRIDGE_LOG" 2>/dev/null || true
    die "Bridge did not receive data from the Arduino (see: scripts/tsp05 logs)"
}

stop_bridge() {
    if bridge_running; then
        info "Stopping bridge"
        docker exec "$CONTAINER" pkill -INT -f 'ros2 launch tsp05_bridge' || true
        for _ in $(seq 1 20); do
            bridge_running || return 0
            sleep 0.25
        done
        docker exec "$CONTAINER" pkill -KILL -f 'ros2 launch tsp05_bridge|tsp05_serial_node|foxglove_bridge' || true
    fi
}

# ----------------------------------------------------------------------
# Arduino
# ----------------------------------------------------------------------

find_arduino_cli() {
    if [ -n "${ARDUINO_CLI:-}" ]; then echo "$ARDUINO_CLI"; return; fi
    if command -v arduino-cli >/dev/null; then command -v arduino-cli; return; fi

    # Extract the arduino-cli bundled with the Arduino IDE AppImage (once)
    local tool="$REPO/.tools/arduino-cli"
    if [ ! -x "$tool" ]; then
        local appimage
        appimage="$(ls -t "$HOME"/Downloads/arduino-ide_*.AppImage 2>/dev/null | head -1 || true)"
        [ -n "$appimage" ] || die "arduino-cli not found (set ARDUINO_CLI=/path/to/arduino-cli)"
        info "Extracting arduino-cli from $(basename "$appimage")" >&2
        local tmp
        tmp="$(mktemp -d)"
        (cd "$tmp" && "$appimage" --appimage-extract 'resources/app/lib/backend/resources/arduino-cli' >/dev/null)
        mkdir -p "$REPO/.tools"
        mv "$tmp/squashfs-root/resources/app/lib/backend/resources/arduino-cli" "$tool"
        rm -rf "$tmp"
    fi
    echo "$tool"
}

flash() {
    local cli was_running=0
    cli="$(find_arduino_cli)"
    if docker container inspect "$CONTAINER" >/dev/null 2>&1 && bridge_running; then
        was_running=1
        stop_bridge
    fi
    check_port_free

    if ! "$cli" lib list 2>/dev/null | grep -q 'SparkFun VL53L1X'; then
        info "Installing SparkFun VL53L1X library"
        "$cli" lib install "SparkFun VL53L1X 4m Laser Distance Sensor"
    fi

    info "Compiling"
    "$cli" compile --fqbn "$FQBN" "$REPO" | grep -E 'Sketch uses|Global variables'
    info "Uploading to $PORT"
    "$cli" upload -p "$PORT" --fqbn "$FQBN" "$REPO"
    info "Flashed"

    if [ "$was_running" = 1 ]; then
        sleep 1
        start_bridge
    fi
}

# ----------------------------------------------------------------------

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
    flash)
        flash ;;
    build)
        ensure_container; build ;;
    unit)
        ensure_container
        in_container_as_user 'cd /tsp05/ros2_ws/src/tsp05_bridge && python3 -m pytest -q -p no:cacheprovider test' ;;
    start)
        ensure_container; ensure_built; start_bridge ;;
    stop)
        docker container inspect "$CONTAINER" >/dev/null 2>&1 && stop_bridge || true ;;
    restart)
        ensure_container; ensure_built; stop_bridge; start_bridge ;;
    logs)
        docker exec -it "$CONTAINER" tail -n 50 -f "$BRIDGE_LOG" ;;
    shell)
        exec "$REPO/docker/f1_new_terminal.sh" ;;
    foxglove)
        ensure_container; ensure_built; start_bridge
        python3 "$REPO/foxglove/make_layout.py" >/dev/null
        if command -v foxglove-studio >/dev/null && ! pgrep -x foxglove-studio >/dev/null; then
            (foxglove-studio >/dev/null 2>&1 &)
        fi
        cat <<EOF2

In Foxglove:
  1. Open connection -> Foxglove WebSocket -> ws://localhost:8765 -> Open
  2. First time only: Layouts menu (top left) -> Import from file ->
     $REPO/foxglove/tsp05_layout.json
EOF2
        ;;
    check|watch|mode|servo|step|dc|safety|calibrate)
        ensure_container; ensure_built; start_bridge
        tty_flag=-i
        [ -t 0 ] && tty_flag=-it
        exec docker exec $tty_flag "$CONTAINER" bash -c "$ROS_ENV; ros2 run tsp05_bridge tsp05 $cmd $*" ;;
    help|-h|--help)
        sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)
        die "unknown command '$cmd' (scripts/tsp05 help)" ;;
esac
