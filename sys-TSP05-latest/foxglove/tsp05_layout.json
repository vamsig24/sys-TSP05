        },
        "second": {
          "direction": "column",
          "first": {
            "direction": "row",
            "first": "Gauge!servo",
            "second": "Gauge!step_target",
            "splitPercentage": 50.0
          },
          "second": {
            "direction": "column",
            "first": {
              "direction": "row",
              "first": "Gauge!tof",
              "second": "Gauge!sharp",
              "splitPercentage": 50.0
            },
            "second": {
              "direction": "column",
              "first": {
                "direction": "row",
                "first": "Gauge!stepper",
                "second": "Gauge!dc_rpm",
                "splitPercentage": 50.0
              },
              "second": {
                "direction": "row",
                "first": "Gauge!dc_position",
                "second": "Indicator!button",
                "splitPercentage": 50.0
              },
              "splitPercentage": 50.0
            },
            "splitPercentage": 33.333333333333336
          },
          "splitPercentage": 25.0
        },
        "splitPercentage": 20.0
      },
      "second": {
        "direction": "column",
        "first": "RawMessages!mapping",
        "second": {
          "direction": "column",
          "first": "Plot!flex_raw",
          "second": {
            "direction": "column",
            "first": "Plot!transfer",
            "second": {
              "direction": "column",
              "first": "Plot!dc_speed",
              "second": "Plot!dc_position",
              "splitPercentage": 50.0
            },
            "splitPercentage": 33.333333333333336
          },
          "splitPercentage": 25.0
        },
        "splitPercentage": 32
      },
      "splitPercentage": 42
    },
    "splitPercentage": 29
  }
}