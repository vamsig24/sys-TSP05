<?xml version="1.0"?>
<package format="3">
  <name>tsp05_bridge</name>
  <version>0.1.0</version>
  <description>Serial bridge between the TSP05 Arduino (sensors and motors) and ROS 2 / Foxglove.</description>
  <maintainer email="vamsig@andrew.cmu.edu">Vamsi Grandhi</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
